ffmpeg/

# Engine runtime status files.
engine/status/

# v0.11 voice preview scratch audio (one sample at a time).
engine/preview/

# v0.7 per-project run history (index into each run's out_dir).
engine/history/

# macOS noise.
.DS_Store
