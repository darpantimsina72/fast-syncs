# ── Secrets — NEVER commit these ─────────────────────────────
# NOTE: git does NOT support inline (end-of-line) comments in .gitignore.
# Every comment must be on its own line, or the pattern silently breaks.

# Local settings file — contains all API keys.
# The .bak is the one-time copy the dub panel's Settings tab takes before it
# first mirrors credentials in here; it holds keys too.
sync_pipeline_settings.json
**/sync_pipeline_settings.json
sync_pipeline_settings.json.bak
**/sync_pipeline_settings.json.bak

# Google Cloud service-account private keys.
vertex_key.json
**/vertex_key.json
service_account.json
**/service_account.json

# Generic key/cert material.
*.pem
*.key

# Environment files (server real keys + client tokens), in any subdir.
.env
**/.env

# ...but DO track example templates.
!*.env.example
!**/*.env.example

# ── Local Python environment ─────────────────────────────────
venv/
**/venv/
__pycache__/
**/__pycache__/
*.pyc

# ── Generated at runtime ─────────────────────────────────────
# Install-mode marker written by setup.bat/setup.sh (--direct).
.direct-mode
sync_cache.json
sync_config.json
sync_results.json
sync_python_log.txt
sync_python_pid.txt
sync_python_done.txt
.clip_tmp.txt
# Scribe transcripts checkpointed by the dubbing engine so a crash in a later
# stage never re-uploads (and re-pays for) the same transcription.
dubbing/data/stt_cache/

# ── Audio + project artifacts ────────────────────────────────
*.wav
*.mp3
*.aif
*.aiff
*.m4a
*.flac
*.ogg
*.RPP
*.RPP-bak

# ── Archives / local distribution copies ─────────────────────
*.zip

# Older parallel copy of the whole project, kept locally only.
# (folder name has a trailing space, so use a wildcard to match it.)
# (Remove this line if you decide to ship that variant instead.)
akash anna's*/

# ── OS / editor cruft ────────────────────────────────────────
.DS_Store
**/.DS_Store
Thumbs.db
.idea/
.vscode/

# Feedback system — token + offline outbox stay local
github_token.txt
feedback_outbox/

# File list shipped inside each release archive; the updaters diff the previous
# copy against the new one to delete files a release no longer ships. It only
# appears in ZIP/release installs, never in a git checkout.
.fast-syncs-manifest
