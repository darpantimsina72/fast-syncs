# ── Real provider keys (server-side only — never shipped to clients) ──
SYNC_ELEVENLABS_KEY=
SYNC_GEMINI_KEY=
SYNC_OPENAI_KEY=
SYNC_ANTHROPIC_KEY=

# ── Client access tokens you issue (comma-separated) ──────────────────
# Each person you share the app with gets one of these (set as their
# SYNC_API_TOKEN). Revoke by removing it here and restarting.
# Leave EMPTY to run open (local testing only — do not deploy open).
SYNC_CLIENT_TOKENS=test-token-123

# ── Optional model + rate-limit overrides ─────────────────────────────
SYNC_GEMINI_MODEL=gemini-2.5-pro
SYNC_GEMINI_AUDIO_MODEL=gemini-2.5-flash
SYNC_OPENAI_MODEL=gpt-4o
SYNC_ANTHROPIC_MODEL=claude-sonnet-4-5
SYNC_RL_PER_MIN=60
